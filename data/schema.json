{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aetheria Item",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "source",
    "tags",
    "attributes"
  ],
  "properties": {
    "id": {
      "type": [
        "string",
        "number"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "rarity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 6
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "set": {
      "type": [
        "string",
        "null"
      ]
    },
    "image": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "attributes": {
      "type": "object"
    }
  }
}